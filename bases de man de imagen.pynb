    },
    {
      "cell_type": "code",
      "source": [
        "# Logical NOT\n",
        "\n",
        "not_x1 = cv2.bitwise_not(X1)\n",
        "\n",
        "plt.figure(figsize=(12,6))\n",
        "plt.subplot(1,2,1)\n",
        "plt.imshow(X1, cmap = 'gray')\n",
        "plt.title(\"$X_1$\")\n",
        "plt.subplot(1,2,2)\n",
        "plt.imshow(not_x1, cmap = 'gray')\n",
        "plt.title(\"$Not X_1$\")\n",
        "\n",
        "plt.show()"
      ],
      "metadata": {

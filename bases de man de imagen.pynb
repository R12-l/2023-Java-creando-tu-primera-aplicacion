            " \n",
            "(212, 256)\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "X1 = cv2.resize(X1, (250, 210))\n",
        "print(X1.shape)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "cY-VHq6IMLJO",
        "outputId": "10a60e67-1417-4cab-fdce-c1744d60864d"
      },
      "execution_count": null,

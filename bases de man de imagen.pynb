            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Logical XOR\n",
        "xor_image = cv2.bitwise_xor(X1, X2)"
      ],
      "metadata": {
        "id": "cb7FaIMrQCBf"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "plt.figure(figsize=(12,6))\n",
        "plt.subplot(1,3,1)\n",
        "plt.imshow(X1, cmap = 'gray')\n",
        "plt.title(\"$X_1$\")\n",
        "plt.subplot(1,3,2)\n",
        "plt.imshow(X2, cmap = 'gray')\n",
        "plt.title(\"$X_2$\")\n",
        "plt.subplot(1,3,3)\n",
        "plt.imshow(xor_image, cmap = 'gray')\n",
        "plt.title(\"$X_1$ XOR $X_2$\")\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 313

            "text/plain": [
              "<Figure size 1200x600 with 3 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Logical OR\n",
        "or_image = cv2.bitwise_or(X1, X2)"
      ],
      "metadata": {
        "id": "DityonK3PQEm"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "plt.figure(figsize=(12,6))\n",
        "plt.subplot(1,3,1)\n",
        "plt.imshow(X1, cmap = 'gray')\n",
        "plt.title(\"$X_1$\")\n",
        "plt.subplot(1,3,2)\n",
        "plt.imshow(X2, cmap = 'gray')\n",
        "plt.title(\"$X_2$\")\n",
        "plt.subplot(1,3,3)\n",
        "plt.imshow(or_image, cmap = 'gray')\n",
        "plt.title(\"$X_1$ OR $X_2$\")\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 313
        },
        "id": "xQpb47xXPcId",
        "outputId": "630aaa58-da6d-4fd5-bf66-055291010cfa"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {

    {
      "cell_type": "code",
      "source": [
        "# Operaciones Lógicas\n",
        "X1 = cv2.imread('X1.png', 0)"
      ],
      "metadata": {
        "id": "VkIuJ4OXLq5w"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "print(type(X1))\n",
        "print(\" \")\n",
        "print(X1.dtype)\n",
        "print(\" \")\n",
        "print(X1.shape)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "pL_mfPz2L5rm",
        "outputId": "2c175761-1e51-4978-b7bc-f1aaa1f85620"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "<class 'numpy.ndarray'>\n",

        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "X2 = cv2.imread('X2.png', 0)\n",
        "X2 = cv2.resize(X2, (250, 210))"
      ],
      "metadata": {
        "id": "oVtvVCwoMuDu"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "plt.imshow(X2, cmap = 'gray')\n",
        "plt.title(\"$X_2$\")\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 453
        },
        "id": "bm0Y0x4eM8Gp",
        "outputId": "5e772004-09ab-416e-dadd-94c673a73e29"
      },
      "execution_count": null,

        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Logical AND\n",
        "and_image = cv2.bitwise_and(X1, X2)"
      ],
      "metadata": {
        "id": "nvhYb-JuNQyg"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "plt.figure(figsize=(12,6))\n",
        "plt.subplot(1,3,1)\n",
        "plt.imshow(X1, cmap = 'gray')\n",
        "plt.title(\"$X_1$\")\n",
        "plt.subplot(1,3,2)\n",
        "plt.imshow(X2, cmap = 'gray')\n",
        "plt.title(\"$X_2$\")\n",
        "plt.subplot(1,3,3)\n",
        "plt.imshow(and_image, cmap = 'gray')\n",
        "plt.title(\"$X_1$ AND $X_2$\")\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 313
        },
        "id": "5sX6DqJkN_tQ",
        "outputId": "3d176dd8-44d0-4882-b6a0-5f5a985683ab"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "display_data",
